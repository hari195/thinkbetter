{
  "name": "gatsby-starter-hello-world",
  "private": true,
  "description": "A simplified bare-bones starter for Gatsby",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "build": "gatsby build",
    "develop": "gatsby develop -H 0.0.0.0",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "start": "npm run develop",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "test": "echo \"Write tests! -> https://gatsby.dev/unit-testing\" && exit 1"
  },
  "dependencies": {
    "babel-plugin-styled-components": "^1.10.7",
    "gatsby": "^2.24.85",
    "gatsby-image": "^2.4.12",
    "gatsby-plugin-dark-mode": "^1.1.2",
    "gatsby-plugin-feed": "^2.5.10",
    "gatsby-plugin-google-analytics": "^2.3.10",
    "gatsby-plugin-manifest": "^2.4.16",
    "gatsby-plugin-offline": "^3.2.15",
    "gatsby-plugin-postcss": "^2.3.6",
    "gatsby-plugin-purgecss": "^5.0.0",
    "gatsby-plugin-sharp": "^2.6.18",
    "gatsby-plugin-sitemap": "^2.4.10",
    "gatsby-plugin-styled-components": "^3.3.10",
    "gatsby-source-filesystem": "^2.3.17",
    "gatsby-transformer-remark": "^2.8.23",
    "gatsby-transformer-sharp": "^2.5.10",
    "react": "^16.12.0",
    "react-dom": "^16.12.0",
    "react-helmet": "^6.1.0",
    "react-toggle": "^4.1.1",
    "styled-components": "^5.1.1",
    "use-dark-mode": "^2.3.1"
  },
  "devDependencies": {
    "prettier": "2.0.5",
    "tailwindcss": "^1.4.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gatsbyjs/gatsby-starter-hello-world"
  },
  "bugs": {
    "url": "https://github.com/gatsbyjs/gatsby/issues"
